// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model AppSetting {
  id               String   @id @default("default")
  goldPricePerGram Float    @default(6500)
  updatedAt        DateTime @updatedAt
}

model Collection {
  id                  String       @id @default(cuid())
  name                String
  description         String       @default("")
  imageUrl            String       @default("")
  shopifyCollectionId String?
  parentId            String?
  parent              Collection?  @relation("SubCollections", fields: [parentId], references: [id], onDelete: SetNull)
  subCollections      Collection[] @relation("SubCollections")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  products            Product[]    @relation("ProductToCollection")
}

model MetalType {
  id        String           @id @default(cuid())
  name      String
  color     String
  status    String           @default("Active")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  purities  PurityLevel[]
  variants  ProductVariant[]
}

model PurityLevel {
  id          String           @id @default(cuid())
  metalId     String
  label       String
  karat       Int              @default(0)
  purityValue Float
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  metal       MetalType        @relation(fields: [metalId], references: [id], onDelete: Cascade)
  variants    ProductVariant[]
}

model Product {
  id               String           @id @default(cuid())
  sku              String
  name             String
  description      String           @default("")
  imageUrl         String           @default("")
  shopifyFileId    String?
  imagesJson       String           @default("[]")
  gender           String           @default("Unisex")
  dimensionWidth   String           @default("")
  dimensionHeight  String           @default("")
  availableSizes   String           @default("[]")
  isRing           Boolean          @default(false)
  pricingMode      String           @default("auto")
  shopifyProductId String?
  status           String           @default("Active")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  collections      Collection[]     @relation("ProductToCollection")
  variants         ProductVariant[]
}

model ProductVariant {
  id                 String       @id @default(cuid())
  productId          String
  metalId            String
  purityId           String
  metalColor         String
  grossWeight        Float
  netGoldWeight      Float        @default(0)
  stoneIncluded      Boolean      @default(false)
  stoneType          String       @default("None")
  stoneWeight        Float        @default(0)
  diamondCategory    String       @default("")
  diamondQualityId   String?
  diamondCount       Int          @default(1)
  pricePerCarat      Float        @default(0)
  wastagePercent     Float        @default(0)
  wastageType        String       @default("percent")
  makingChargeType   String       @default("percent")
  makingChargeValue  Float        @default(0)
  otherCharges       Float        @default(0)
  gstPercent         Float        @default(3)
  manualPrice        Float        @default(0)
  stoneRate          Float        @default(0)
  stonesJson         String       @default("[]")
  imageUrl           String       @default("")
  shopifyFileId      String?
  shopifyVariantId   String?
  status             String       @default("Active")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  metal              MetalType    @relation(fields: [metalId], references: [id])
  purity             PurityLevel     @relation(fields: [purityId], references: [id])
  diamondQuality     DiamondQuality? @relation(fields: [diamondQualityId], references: [id], onDelete: SetNull)
}

model GemstoneType {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String   @default("")
  defaultRate Float    @default(0)
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DiamondQuality {
  id        String               @id @default(cuid())
  color     String
  clarity   String
  name      String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  slabs     DiamondPricingSlab[]
  variants  ProductVariant[]

  @@unique([color, clarity])
}

model DiamondPricingSlab {
  id            String         @id @default(cuid())
  qualityId     String
  centsFrom     Float
  centsTo       Float
  pricePerCarat Float
  status        String         @default("Active")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  quality       DiamondQuality @relation(fields: [qualityId], references: [id], onDelete: Cascade)

  @@index([qualityId, status])
}
